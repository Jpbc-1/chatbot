# Copie este arquivo para ".env" e preencha com a sua chave real.
#   cp .env.example .env
#
# Nunca faça commit do arquivo ".env" com sua chave real (ele já está
# listado no .gitignore deste projeto).

# Chave da API do Google Gemini (obrigatória)
# Gere a sua gratuitamente em: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui

# Modelo do Gemini a ser utilizado (opcional).
# Se não for definido, o projeto usa "gemini-3.5-flash" por padrão.
# Lista de modelos disponíveis: https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-3.5-flash
